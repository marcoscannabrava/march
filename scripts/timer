#!/bin/bash

# Bar widget state: an end timestamp it ticks from.
STATE_DIR="$HOME/.local/state/march"
STATE_FILE="$STATE_DIR/timer.json"
PID_FILE="$STATE_DIR/timer.pid"
SOUND_FILE="$HOME/.local/share/sounds/default-alarm.mp3"

escape_json() {
    local text=${1//\\/\\\\}
    text=${text//\"/\\\"}
    printf '%s' "${text//$'\n'/ }"
}

write_state() {
    mkdir -p "$STATE_DIR"
    printf '{"endsAt": %s, "message": "%s"}\n' "$1" "$(escape_json "$2")" > "$STATE_FILE"
    # Nudge the bar widget, quietly.
    omarchy-shell -q marcos.countdown reload 2>/dev/null || true
}

cancel_running() {
    [ -f "$PID_FILE" ] || return 0
    kill "$(cat "$PID_FILE")" 2>/dev/null
    rm -f "$PID_FILE"
}

stop_timer() {
    cancel_running
    write_state 0 ""
}

start_timer() {
    cancel_running

    duration=$1
    message="${2:-Your $duration timer is up!}"

    # Bare number means minutes; 10m and 30s also work.
    if [[ "$duration" =~ ^[0-9]+$ ]]; then
        total_seconds=$((duration * 60))
    elif [[ "$duration" =~ ^([0-9]+)m$ ]]; then
        total_seconds=$((${BASH_REMATCH[1]} * 60))
    elif [[ "$duration" =~ ^([0-9]+)s$ ]]; then
        total_seconds=${BASH_REMATCH[1]}
    else
        notify-send "Timer Error" "Invalid format. Use numbers for minutes (e.g. 10) or 10s for seconds."
        exit 1
    fi

    write_state "$(($(date +%s) + total_seconds))" "$message"

    # One sleep instead of a per-second loop.
    (
        echo $BASHPID > "$PID_FILE"
        sleep "$total_seconds" &
        countdown=$!
        # `wait` lets a stop kill the sleep at once.
        trap 'kill $countdown 2>/dev/null; exit 0' TERM
        wait $countdown

        notify-send -u critical -t 0 -i clock "Timer Finished" "$message"
        # Background, so the alarm does not delay the clear.
        paplay --volume=65536 "$SOUND_FILE" 2>/dev/null &

        # Hold 00:00, then clear. A newer timer owns the file.
        sleep 5
        if [ "$(cat "$PID_FILE" 2>/dev/null)" = "$BASHPID" ]; then
            write_state 0 ""
            rm -f "$PID_FILE"
        fi
    ) &
}

# Logic to handle arguments
case "$1" in
    stop)
        stop_timer
        ;;
    *)
        if [ -z "$1" ]; then
            echo "Usage: $0 <duration> [message]"
            echo "  duration: minutes (e.g. 10), or with suffix (e.g. 10m, 30s)"
            echo "  message:  optional custom notification message"
            echo "  $0 stop   stop the running timer"
            exit 1
        fi
        start_timer "$1" "$2"
        ;;
esac
