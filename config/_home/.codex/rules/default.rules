prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "checkout"], decision="allow")
prefix_rule(pattern=["bq", "show"], decision="allow")
prefix_rule(pattern=["bq", "query"], decision="allow")
prefix_rule(pattern=["bq", "ls"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "bq ls --format=json --transfer_config --transfer_location=US --project_id=rize-education > /tmp/rize_scheduled_queries.json"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "bq query --use_legacy_sql=false --dry_run < /tmp/update_instructor_messages.sql"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "bq query --use_legacy_sql=false --dry_run < /tmp/update_instructor_performance.sql"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "bq update --transfer_config --location=US --params=\"$(jq -c . /tmp/update_instructor_messages_params.json)\" projects/420139605896/locations/us/transferConfigs/64143a45-0000-2a70-b54b-30fd381067f0"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "bq update --transfer_config --location=US --params=\"$(jq -c . /tmp/update_instructor_performance_params.json)\" projects/420139605896/locations/us/transferConfigs/641ff4cc-0000-2b22-89d5-089e0831d59c"], decision="allow")
prefix_rule(pattern=["/usr/bin/zsh", "-lc", "bq ls --format=json --transfer_config --transfer_location=US --project_id=rize-education > /tmp/rize_scheduled_queries_after.json"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow")
prefix_rule(pattern=["gh", "pr", "review"], decision="allow")
