#!/usr/bin/env bash

set -u

argument=${1:-}
title="Codex needs your input"
message="Open the terminal to continue."
sound_file="/usr/share/sounds/freedesktop/stereo/message-new-instant.oga"

# Existing Codex sessions may still have the previous argv loaded.
if [[ "$argument" == "--complete" ]]; then
  argument=${2:-}
fi

if [[ "$argument" != "--input" ]]; then
  if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$argument"; then
    exit 0
  fi

  if [[ $(jq -r '.type // empty' <<<"$argument") != "agent-turn-complete" ]]; then
    exit 0
  fi

  title="Codex is ready"
  sound_file="/usr/share/sounds/freedesktop/stereo/complete.oga"
  message=$(jq -r '
    (."last-assistant-message" // "Turn complete" | tostring)
    | gsub("[\\r\\n\\t]+"; " ")
    | gsub("  +"; " ")
    | if length > 280 then .[0:277] + "..." else . end
  ' <<<"$argument")
fi

notify-send \
  --urgency=normal \
  --app-name=Codex \
  --icon=dialog-information \
  "$title" \
  "$message"

if command -v canberra-gtk-play >/dev/null 2>&1; then
  canberra-gtk-play --file="$sound_file" --description="$title" >/dev/null 2>&1
elif command -v pw-play >/dev/null 2>&1; then
  pw-play "$sound_file" >/dev/null 2>&1
fi
